# Docker Compose host binding. Keep 127.0.0.1 when Nginx/Caddy runs on the host.
MALIANG_BIND_ADDRESS=127.0.0.1
MALIANG_PORT=8787

# Put optional provider keys here only when a provider is configured to read an environment variable.
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# 允许嵌入 /live-demo 的直播页来源，多个来源用空格分隔
# LIVE_DEMO_FRAME_ANCESTORS='self' https://live.example.com
