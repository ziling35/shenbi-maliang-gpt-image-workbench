容器内访问
docker compose exec -T -e TEST_URL="https://oss6.cxkedu.shop/images/2026/08/17/1786977328_d1af9c8a1aa6c4c4dff4d3f80cf56776.png" maliang bun -e 'const started=performance.now();const response=await fetch(process.env.TEST_URL);const headersAt=performance.now();const buffer=await response.arrayBuffer();const ended=performance.now();const totalMs=Math.round(ended-started);const bytes=buffer.byteLength;const speed=totalMs?Math.round(bytes*1000/totalMs):bytes;console.log({status:response.status,bytes,firstByteMs:Math.round(headersAt-started),bodyDownloadMs:Math.round(ended-headersAt),totalMs,speedBytesPerSecond:speed,speedMbps:Number((speed*8/1024/1024).toFixed(2))});'

